# NLP to Structured Data MCP Server Configuration - Sample
# Copy this file to .env and modify the values as needed

# Metadata Service Configuration
METADATA_SERVICE_BASE_URL=http://localhost:8080
METADATA_SERVICE_ENABLED=true

# Server Configuration
SERVER_NAME=enhanced-nlp-data-server
DEBUG_MODE=true

# Cache Configuration
CACHE_ENABLED=true
AUTO_DISCOVERY_ENABLED=true

# Optional: Authentication (if your metadata service requires it)
# METADATA_SERVICE_API_KEY=your_api_key_here
# METADATA_SERVICE_USERNAME=your_username
# METADATA_SERVICE_PASSWORD=your_password