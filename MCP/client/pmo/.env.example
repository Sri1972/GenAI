# Multi-LLM PMO Client Configuration
# Copy this to .env and configure your preferred LLM provider

# ==============================================================================
# GENERAL LLM SETTINGS
# ==============================================================================

# Choose your LLM provider: anthropic, openai, bedrock, gemini
LLM_PROVIDER=bedrock

# Maximum tokens for LLM responses (applies to all providers)
LLM_MAX_TOKENS=1000

# ==============================================================================
# ANTHROPIC CLAUDE SETTINGS
# ==============================================================================

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model to use
# Options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ==============================================================================
# OPENAI SETTINGS
# ==============================================================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-4

# Optional: Custom base URL for Azure OpenAI or other OpenAI-compatible services
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/

# ==============================================================================
# AWS BEDROCK SETTINGS
# ==============================================================================

# Bedrock API Key (optional, if using API key auth instead of AWS credentials)
BEDROCK_API_KEY=your_bedrock_api_key_here

# Bedrock model to use
# Anthropic models: anthropic.claude-3-sonnet-20240229-v1:0, anthropic.claude-3-haiku-20240307-v1:0
# Other models: amazon.titan-text-express-v1, ai21.j2-ultra-v1, cohere.command-text-v14
BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# Optional: Custom Bedrock endpoint
# BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com/model/{BEDROCK_MODEL}/invoke

# Bedrock Anthropic version (for Claude models)
BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# AWS Region
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# AWS Credentials (if not using IAM roles or AWS CLI configured credentials)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==============================================================================
# GOOGLE GEMINI SETTINGS
# ==============================================================================

# Google AI API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
# Options: gemini-pro, gemini-pro-vision, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-pro

# ==============================================================================
# CHART GENERATION SETTINGS
# ==============================================================================

# Timeout for chart generation (seconds)
CHART_SPAWNABLE_TIMEOUT=30

# ==============================================================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT SCENARIOS
# ==============================================================================

# Configuration 1: Using Anthropic Claude directly
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Configuration 2: Using OpenAI GPT-4
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4

# Configuration 3: Using Azure OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_azure_openai_key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# OPENAI_MODEL=gpt-4

# Configuration 4: Using AWS Bedrock with AWS credentials
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
# AWS_REGION=us-east-1
# (AWS credentials configured via AWS CLI or IAM roles)

# Configuration 5: Using Google Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-pro

# ==============================================================================
# INSTALLATION REQUIREMENTS BY PROVIDER
# ==============================================================================

# Anthropic: pip install anthropic
# OpenAI: pip install openai
# Bedrock: pip install boto3 botocore
# Gemini: pip install google-generativeai

# ==============================================================================
# NOTES
# ==============================================================================

# 1. Only configure the provider you plan to use
# 2. The client will fall back to Bedrock if the chosen provider fails to initialize
# 3. You can switch providers at runtime using the :provider command in the REPL
# 4. Cost considerations:
#    - Anthropic Claude: Pay per token, good balance of quality/cost
#    - OpenAI GPT-4: More expensive but very capable
#    - Bedrock: AWS pricing, good for enterprise
#    - Gemini: Competitive pricing from Google
# 5. Rate limits vary by provider - check documentation for your use case