# Environment Configuration for NLP to Structured Data System
# Copy this file to .env and fill in your values

# ========================================
# Claude Bedrock Configuration
# ========================================

# Bedrock model to use (choose one)
BEDROCK_MODEL=anthropic.claude-sonnet-4
# BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
# BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# API Key for direct Bedrock HTTP calls (optional if using AWS credentials)
# BEDROCK_API_KEY=your-bedrock-api-key-here

# Custom Bedrock endpoint (optional, uses default AWS endpoints if not set)
# BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com/model/anthropic.claude-sonnet-4/invoke

# Anthropic version for Claude models (optional, auto-detected if not set)
BEDROCK_ANTHROPIC_VERSION=20250514

# ========================================
# AWS Configuration
# ========================================

# AWS Region for Bedrock
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# AWS Credentials (if not using IAM roles or AWS CLI configured)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token  # Only if using temporary credentials

# ========================================
# Alternative LLM Providers
# ========================================

# Anthropic Direct API (alternative to Bedrock)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API
# OPENAI_API_KEY=your-openai-api-key

# ========================================
# Application Settings
# ========================================

# Default LLM provider to use
# Options: claude_bedrock, anthropic, openai, mock
DEFAULT_LLM_PROVIDER=claude_bedrock

# Logging level
LOG_LEVEL=INFO

# Data processing settings
MAX_FILE_SIZE_MB=100
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ========================================
# Database Configuration (Optional)
# ========================================

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/nlp_data

# Redis (for caching)
# REDIS_URL=redis://localhost:6379/0

# ========================================
# Security Settings
# ========================================

# API key for your own services (if exposing endpoints)
# API_KEY=your-secure-api-key

# Enable/disable certain features
ENABLE_FILE_UPLOAD=true
ENABLE_EXTERNAL_APIS=true
ENABLE_CACHING=true

# ========================================
# Development Settings
# ========================================

# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE_LOGGING=false

# Test mode (uses mock data)
TEST_MODE=false