# Environment Configuration Example
# Copy this file to .env and fill in your values

# ── OpenAI Configuration (optional, not used by default) ──────────────────────
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Azure OpenAI Configuration ────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-apim-endpoint.example.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# ── Client API Server Configuration ──────────────────────────────────────────
CLIENT_API_PORT=8001
ENV=development

# ── Figma Configuration ───────────────────────────────────────────────────────
# Get your token: Figma → top-left menu → Help & Account → Account Settings → Personal Access Tokens
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret

# ── AWS Bedrock / Claude Configuration ────────────────────────────────────────
AWS_REGION=us-east-1
CLAUDE_MODEL_ID=arn:aws:bedrock:us-east-1:123456789012:application-inference-profile/your-profile-id

# ── LiteLLM Proxy ────────────────────────────────────────────────────────────
LITELLM_API_BASE=https://your-litellm-proxy.example.com
LITELLM_API_KEY=sk-your-litellm-api-key
LITELLM_TIMEOUT=120

# SSL Certificate for the LiteLLM proxy (PEM format, newlines escaped as \n)
LITELLM_SSL_CERT=-----BEGIN CERTIFICATE-----\nYOUR_CERTIFICATE_CONTENT_HERE\n-----END CERTIFICATE-----

# Claude model names as registered in the LiteLLM proxy
LITELLM_HAIKU_MODEL=claude-haiku-4-5
LITELLM_SONNET_45_MODEL=claude-sonnet-4-5
LITELLM_SONNET_46_MODEL=claude-sonnet-4-6

# ── TurboUIGen Service URLs ──────────────────────────────────────────────────
# Change TURBOUI_HOST to your EC2 public IP or domain when deploying to AWS
TURBOUI_HOST=localhost
TURBOUI_PORT=3000

# Figma MCP server — can run on same AWS instance as the API
TURBOUI_MCP_HOST=localhost
TURBOUI_MCP_PORT=7771

# Base ports for generated project servers
TURBOUI_HTML_PORT_START=6100
TURBOUI_REACT_PORT_START=5173

# ── Design System ────────────────────────────────────────────────────────────
# Path to the design system folder for Figma wireframes and web generation.
# Leave blank to use the bundled Mobility Global design system.
DESIGN_SYSTEM_PATH=

# ── Storybook ────────────────────────────────────────────────────────────────
# URL of the Storybook instance for the active design system.
STORYBOOK_URL=http://localhost:6006

# ── Junction Directory ───────────────────────────────────────────────────────
# Directory used for clean-path junctions (avoids spaces in OneDrive paths).
TURBOUI_JUNCTION_DIR=C:/Users/youruser/.turboui-junctions
