# Environment & secrets
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node
node_modules/
dist/
.vite/

# Generated folder contents (large, ephemeral - can be regenerated)
# Keep the folder structure but ignore contents
WebUIGenerator/generated/web-apps/*
!WebUIGenerator/generated/web-apps/.gitkeep
WebUIGenerator/generated/shared-node-modules/*
!WebUIGenerator/generated/shared-node-modules/.gitkeep
WebUIGenerator/generated/.jobs/
FigmaMockupGenerator/generated/*
!FigmaMockupGenerator/generated/.gitkeep
WebAPIGenerator/generated/web-api/*
!WebAPIGenerator/generated/web-api/.gitkeep
ContentAgents/library/
Workflow/workflows/*/runs/
LandDAgent/library/
DataQualityAgent/library/

# Local runtime state / scratch files, not source
.model_selection.json
WebUIGenerator/sdk_diff_tmp.txt

# Database files
*.db
*.sqlite
*.sqlite3
# ...except DataQualityAgent's own example fixtures -- real, small, hand-
# built test data meant to be committed, not runtime state.
!DataQualityAgent/examples/*.sqlite
!DataQualityAgent/examples/*.sqlite3

# Office lock files (created while a file is open in Excel/Word, e.g.
# ~$customers.xlsx) -- transient, never real content.
~$*

# Logs
*.log
server.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
*.zip
